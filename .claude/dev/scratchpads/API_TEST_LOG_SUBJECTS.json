    {
      "test_id": 8,
      "name": "POST with subjects filter",
      "method": "POST",
      "parameters": {
        "subjects": [
          "02"
        ]
      },
      "status": 400,
      "result": "ERROR",
      "notes": "Parameter not supported on /subjects endpoint"
    },
    {
      "test_id": 9,
      "name": "POST with subjects + includeTables",
      "method": "POST",
      "parameters": {
        "subjects": [
          "02"
        ],
        "includeTables": true
      },
      "status": 400,
      "result": "ERROR",
      "notes": "subjects parameter not supported"
    },
    {
      "test_id": 10,
      "name": "POST with recursive + lang",
      "method": "POST",
      "parameters": {
        "recursive": true,
        "lang": "en"
      },
      "status": 200,
      "response_time_ms": 166,
      "response_size_bytes": 35127,
      "result": "PASS",
      "notes": "Combined parameters work well"
    },
    {
      "test_id": 11,
      "name": "POST with includeTables",
      "method": "POST",
      "parameters": {
        "includeTables": true
      },
      "status": 200,
      "response_time_ms": 112,
      "response_size_bytes": 1017,
      "result": "PASS",
      "notes": "Tables array added to subjects"
    },
    {
      "test_id": 12,
      "name": "POST with invalid language",
      "method": "POST",
      "parameters": {
        "lang": "invalid"
      },
      "status": 400,
      "error_code": "REQUEST-LANGUAGE",
      "result": "ERROR (Expected)",
      "notes": "Correct error handling for invalid language"
    },
    {
      "test_id": 13,
      "name": "POST with recursive as string",
      "method": "POST",
      "parameters": {
        "recursive": "yes"
      },
      "status": 200,
      "response_time_ms": 129,
      "result": "PASS",
      "notes": "Type coercion - string treated as falsy"
    },
    {
      "test_id": 14,
      "name": "POST with malformed JSON",
      "method": "POST",
      "body": "{invalid json}",
      "status": 200,
      "result": "PASS (Lenient)",
      "notes": "API treats malformed JSON as empty body"
    },
    {
      "test_id": 15,
      "name": "POST with format=XML",
      "method": "POST",
      "parameters": {
        "format": "XML"
      },
      "status": 200,
      "response_time_ms": 120,
      "response_size_bytes": 1431,
      "content_type": "text/xml; charset=utf-8",
      "result": "PASS",
      "notes": "XML format works correctly"
    },
    {
      "test_id": 16,
      "name": "POST with all parameters",
      "method": "POST",
      "parameters": {
